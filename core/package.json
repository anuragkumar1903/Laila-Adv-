{
  "name": "laila-cli",
  "version": "1.0.3",
  "description": "Laila: An advanced, local-first AI developer assistant with MCP, Vision, and Multi-Agent Swarm capabilities.",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "laila-cli": "./dist/cli/index.js",
    "laila": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli/index.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "ai",
    "cli",
    "developer-tools",
    "ollama",
    "mcp",
    "agent",
    "swarm"
  ],
  "author": "Anurag Kumar",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anuragkumar1903/Laila-Adv-.git"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "glob": "^13.0.6",
    "highlight.js": "^11.12.0",
    "ignore": "^7.0.8",
    "marked": "^18.0.11",
    "marked-terminal": "^7.3.0",
    "ora": "^9.4.1",
    "playwright": "^1.62.1",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "highlight.js": "^11.12.0",
    "marked-terminal": {
      "marked": "$marked"
    }
