{
  "compilerOptions": {
    // ── Output ─────────────────────────────────────────
    "rootDir": "./src",
    "outDir": "./dist",

    // ── Module system (ESM + Node 24) ──────────────────
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],

    // ── Emit helpers ───────────────────────────────────
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    // ── Type safety ────────────────────────────────────
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
